# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here
# Optional: Set GUILD_ID for instant slash command registration in your server
GUILD_ID=

# Google Gemini API Keys (comma-separated, 4-5+ keys from separate Google projects recommended)
GEMINI_API_KEYS=key1,key2,key3,key4,key5

# Recommended fastest & most stable Flash-Lite model + automatic fallbacks
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# true = auto-translate in ALL channels the bot can access (use /translate-off to exclude a channel)
# false = only translate in channels enabled via AUTO_TRANSLATE_CHANNEL_IDS or /translate-on
AUTO_TRANSLATE_ALL=true
AUTO_TRANSLATE_CHANNEL_IDS=
IGNORED_CHANNEL_IDS=

# Conversation context & anti-spam message batching
CONTEXT_MAX_MESSAGES=4
CONTEXT_TTL_MS=600000
BATCH_DEBOUNCE_MS=0
QUOTA_ALERT_COOLDOWN_MS=900000

# Optional: Turso Cloud DB for permanent /translate-on and /translate-off persistence across Render restarts
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Set to true to reply directly to the message (without pinging), or false to send cleanly below like BabelBot
REPLY_TO_MESSAGE=false
